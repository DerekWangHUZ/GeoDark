#include <winresrc.h>

#define IDI_APP_ICON 1

IDI_APP_ICON ICON "../assets/geodark.ico"

1 VERSIONINFO
FILEVERSION @GEODARK_VERSION_COMMA@
PRODUCTVERSION @GEODARK_VERSION_COMMA@
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Derek Wang"
            VALUE "FileDescription", "GeoDark Windows 11 Auto Day/Night Theme Switcher"
            VALUE "FileVersion", "@GEODARK_VERSION_DOTTED@"
            VALUE "InternalName", "GeoDark"
            VALUE "LegalCopyright", "Copyright (C) 2026 Derek Wang"
            VALUE "OriginalFilename", "GeoDark.exe"
            VALUE "ProductName", "GeoDark"
            VALUE "ProductVersion", "@GEODARK_VERSION_DOTTED@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
